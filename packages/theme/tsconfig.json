{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@cap/layout": ["../layout/src"],
      "@cap/layout/*": ["../layout/src/*"],
      "@cap/module-auth": ["../modules/auth/src"],
      "@cap/module-auth/*": ["../modules/auth/src/*"],
      "@cap/platform-core": ["../platform-core/src"],
      "@cap/platform-core/*": ["../platform-core/src/*"],
      "@cap/shared-types": ["../shared-types/src"],
      "@cap/shared-types/*": ["../shared-types/src/*"]
    },
    "types": ["node", "vite/client", "react", "react-dom", "react-router-dom", "classnames", "react-use"]
  },
  "include": ["src/**/*", "vite-env.d.ts"]
}
