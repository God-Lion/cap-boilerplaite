{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@cap/module-auth": [
        "../modules/auth/src",
        "../platform-core/src/stubs/auth-shim.tsx"
      ],
      "@cap/module-auth/*": [
        "../modules/auth/src/*",
        "../platform-core/src/stubs/auth-shim.tsx"
      ],
      "@cap/shared-types": ["../shared-types/src"],
      "@cap/shared-types/*": ["../shared-types/src/*"],
      "@cap/theme": ["../theme/src"],
      "@cap/theme/*": ["../theme/src/*"],
      "@cap/layout": ["../layout/src"],
      "@cap/layout/*": ["../layout/src/*"],
      "@cap/platform-core": ["../platform-core/src"],
      "@cap/platform-core/*": ["../platform-core/src/*"]
    },
    "types": ["node", "vite/client", "react", "react-dom"]
  },
  "include": ["src/**/*"]
}
