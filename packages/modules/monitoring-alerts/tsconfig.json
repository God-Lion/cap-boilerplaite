{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "types": ["node", "vite/client", "react", "react-dom"],
    "paths": {
      "@cap/platform-core": ["../../platform-core/src"],
      "@cap/platform-core/*": ["../../platform-core/src/*"],
      "@cap/layout": ["../../layout/src"],
      "@cap/layout/*": ["../../layout/src/*"],
      "@cap/module-monitoring-alerts": ["src"],
      "@cap/module-monitoring-alerts/*": ["src/*"],
      "@/": ["src"],
      "@/*": ["src/*"],
      "@monitoring": ["src"],
      "@monitoring/*": ["src/*"],
      "@monitoring/anomaly-detection": ["src/modules/anomaly-detection"],
      "@monitoring/anomaly-detection/*": ["src/modules/anomaly-detection/*"],
      "@monitoring/fraud-detection": ["src/modules/fraud-detection"],
      "@monitoring/fraud-detection/*": ["src/modules/fraud-detection/*"],
      "@monitoring/alert-manager": ["src/modules/alert-manager"],
      "@monitoring/alert-manager/*": ["src/modules/alert-manager/*"],
      "@monitoring/threat-intelligence": ["src/modules/threat-intelligence"],
      "@monitoring/threat-intelligence/*": ["src/modules/threat-intelligence/*"],
      "@monitoring/security-overview": ["src/modules/security-overview"],
      "@monitoring/security-overview/*": ["src/modules/security-overview/*"],
      "@monitoring/domain-kernel": ["src/domain-kernel"],
      "@monitoring/domain-kernel/*": ["src/domain-kernel/*"]
    }
  },
  "include": ["src/**/*"]
}
