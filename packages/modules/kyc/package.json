{
  "name": "@cap/module-kyc",
  "version": "0.1.0",
  "description": "KYC Verification Module with Alternative Identity Verification for citizens, refugees, and undocumented individuals",
  "author": "CAP Team",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./domain-kernel": {
      "types": "./src/domain-kernel/src/index.ts",
      "import": "./src/domain-kernel/src/index.ts",
      "default": "./src/domain-kernel/src/index.ts"
    },
    "./registry": {
      "types": "./src/registry/KycRegistry.ts",
      "import": "./src/registry/KycRegistry.ts",
      "default": "./src/registry/KycRegistry.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-router-dom": "^6.28.0 || ^7.0.0"
  },
  "dependencies": {
    "@cap/civil-registry": "workspace:*",
    "@cap/platform-api": "workspace:*",
    "@cap/platform-core": "workspace:*",
    "@tanstack/react-query": "^5.90.12",
    "date-fns": "^4.1.0",
    "immer": "^11.0.1",
    "react-hook-form": "^7.69.0",
    "zod": "^4.2.1",
    "react-webcam": "^7.2.0",
    "tesseract.js": "^5.1.1",
    "@zxing/library": "^0.11.0",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
