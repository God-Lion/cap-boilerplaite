{
  "name": "cap-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app",
    "packages/api-contracts",
    "packages/layout",
    "packages/platform-core",
    "packages/platform-store",
    "packages/platform-ui",
    "packages/shared-types",
    "packages/theme",
    "packages/modules/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cap/app",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test:e2e": "npm run test:e2e --workspace=@cap/app",
    "cspell": "cspell --no-progress --show-suggestions --relative --dot --gitignore \"**\""
  },
  "dependencies": {
    "@mui/utils": "^7.3.9",
    "@tanstack/react-query": "^5.99.0",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-import": "^2.32.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}