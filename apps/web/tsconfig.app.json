{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"],
      "core/*": ["./src/core/*"],
      "app/*": ["./src/app/*"],
      "src/configs/*": ["../../packages/platform-core/src/configs/*"],
      "src/store/*": ["../../packages/platform-core/src/store/*"],
      "src/core/contexts/*": ["../../packages/platform-core/src/contexts/*"],
      "src/types/*": ["../../packages/platform-core/src/types/*"],
      "src/core/types/*": ["../../packages/platform-core/src/types/*"],
      "src/theme/*": ["../../packages/platform-core/src/theme/*"],
      "@/store/*": ["../../packages/platform-core/src/store/*"]
    },
    "types": ["vite-plugin-pwa/info", "vite-plugin-pwa/client", "vite/client", "node"]
  },
  "include": ["src", ".react-router"]
}
